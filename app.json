{
  "expo": {
    "name": "Kakeibo",
    "slug": "Kakeibo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kakeibo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.jaswanth.kakeibo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F1F1F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Kakeibo",
      "allowBackup": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F1F1F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Kakeibo uses the camera to scan UPI QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kakeibo reads a QR code from a photo you pick.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Kakeibo reads a QR code from a photo you pick, and removes the payment QRs it saves.",
          "savePhotosPermission": "Kakeibo saves the payment QR so you can scan it in your UPI app, then deletes it.",
          "granularPermissions": []
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Kakeibo opens your contacts so you can pay someone by their phone number."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#1F1F1F"
  }
}
