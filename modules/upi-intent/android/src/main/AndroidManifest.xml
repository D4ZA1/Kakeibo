<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android 11+ hides other apps unless we declare what we look for. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="upi" android:host="pay" />
    </intent>
  </queries>

  <application>
    <!-- Hands the generated QR image to the UPI app (shareQrImage). -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.upiintent.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/upi_intent_paths" />
    </provider>
  </application>
</manifest>
